{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sysbiosr.kineselectsr.selection_record.v2",
  "title": "KineSelectSR final selection record",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "requested_selector",
    "actual_selector",
    "selection_objective",
    "winner_candidate_id",
    "fallback_reason"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "invalid"
      ]
    },
    "requested_selector": {
      "type": "string",
      "enum": [
        "fpms",
        "alpha"
      ]
    },
    "actual_selector": {
      "type": "string",
      "enum": [
        "fpms",
        "alpha"
      ]
    },
    "selection_objective": {
      "type": "string",
      "enum": [
        "rollout",
        "deriv"
      ]
    },
    "winner_candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^candidate-[0-9]{6,}$"
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tie_break_trace": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "alpha": {
      "type": "number",
      "minimum": 1.0
    },
    "eps": {
      "type": "number",
      "exclusiveMinimum": 0.0
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "actual_selector": {
            "const": "fpms"
          },
          "status": {
            "const": "success"
          }
        },
        "required": [
          "actual_selector",
          "status"
        ]
      },
      "then": {
        "properties": {
          "tie_break_trace": {
            "type": "object",
            "required": [
              "criteria",
              "cost_dimensions",
              "ranked_scores",
              "degenerate_dimensions"
            ],
            "properties": {
              "criteria": {
                "const": "DR_KX"
              },
              "cost_dimensions": {
                "const": [
                  "log_derivative_loss",
                  "log_rollout_loss",
                  "kinetic_term_count",
                  "ast_complexity"
                ]
              },
              "degenerate_dimensions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "ranked_scores": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "raw_costs",
                    "normalized_costs",
                    "candidate_id",
                    "score",
                    "rank"
                  ],
                  "properties": {
                    "raw_costs": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "normalized_costs": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
